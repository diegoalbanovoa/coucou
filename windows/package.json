{
  "name": "coucou-windows",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
